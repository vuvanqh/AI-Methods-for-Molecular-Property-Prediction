# ==============================================================================
# AI Methods for Molecular Property Prediction - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# PostgreSQL Database & pgvector
# ------------------------------------------------------------------------------
# For Docker Compose (inter-container networking on port 5432):
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/molecules

# For Local Development on host (Docker forwards host 5433 to container 5432):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/molecules

# ------------------------------------------------------------------------------
# LLM & OpenRouter Settings
# ------------------------------------------------------------------------------
# Required for generating grounded scientific explanations via OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM model identifier on OpenRouter
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Alternative models:
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# Microservice URLs (Defaults)
# ------------------------------------------------------------------------------
# For Docker Compose:
GNN_SERVICE_URL=http://gnn-xai:8000/gnn-xai

# For Local Development outside Docker:
# GNN_SERVICE_URL=http://127.0.0.1:8000/gnn-xai

